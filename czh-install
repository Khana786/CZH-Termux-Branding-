#!/data/data/com.termux/files/usr/bin/bash

REPO_URL="https://github.com/Khana786/CZH-Termux-Branding-.git"
REPO="$HOME/CZH-Termux-Branding-"
TARGET="$HOME/CZH"
BASHRC="$HOME/.bashrc"
MARKER="# === CZH STARTUP BRANDING ==="

printf '\033[1;34m⚡ CZH INSTALL SYSTEM ⚡\033[0m\n'
printf '\033[1;32mCIPHER ZERO HACKERS\033[0m\n\n'

echo "🔐 CZH White Hat setup starting..."

if ! command -v git >/dev/null 2>&1; then
    echo "❌ Git is not installed."
    echo "Run: pkg install git -y"
    exit 1
fi

if [ ! -d "$REPO/.git" ]; then
    echo "📥 Downloading official CZH branding..."
    git clone "$REPO_URL" "$REPO" || {
        echo "❌ Could not clone CZH repository."
        exit 1
    }
else
    echo "🔄 CZH repository already exists."
    git -C "$REPO" pull --ff-only || exit 1
fi

mkdir -p "$TARGET"

cp "$REPO/banner.sh" "$TARGET/banner.sh"
cp "$REPO/czh-config" "$TARGET/czh-config"

chmod +x "$TARGET/banner.sh"

if [ -f "$BASHRC" ] && grep -qF "$MARKER" "$BASHRC"; then
    echo "🔐 CZH startup branding already configured."
else
    if [ -f "$BASHRC" ]; then
        cp "$BASHRC" "$BASHRC.czh-backup"
    fi

    cat >> "$BASHRC" <<'EOF'

# === CZH STARTUP BRANDING ===
if [ -x "$HOME/CZH/banner.sh" ]; then
    "$HOME/CZH/banner.sh"
fi
# === CZH STARTUP BRANDING END ===
EOF

    echo "✅ CZH startup branding configured."
fi

mkdir -p "$PREFIX/bin"

cat > "$PREFIX/bin/czh-update" <<'EOF'
#!/data/data/com.termux/files/usr/bin/bash

REPO="$HOME/CZH-Termux-Branding-"
TARGET="$HOME/CZH"

printf '\033[1;34m⚡ CZH UPDATE SYSTEM ⚡\033[0m\n'
printf '\033[1;32mCIPHER ZERO HACKERS\033[0m\n\n'

if [ ! -d "$REPO/.git" ]; then
    echo "❌ CZH repository not found."
    echo "Run: czh-install"
    exit 1
fi

echo "🔄 Checking official CZH branding updates..."

git -C "$REPO" pull --ff-only || {
    echo "❌ Update failed."
    exit 1
}

cp "$REPO/banner.sh" "$TARGET/banner.sh"
cp "$REPO/czh-config" "$TARGET/czh-config"
chmod +x "$TARGET/banner.sh"

echo
echo "✅ CZH BRANDING UPDATED SUCCESSFULLY"
echo "⚡ CZH HACKERS"
echo "👑 AARHIV HACKERS"
echo "🔐 CIPHER ZERO HACKERS"
echo "🛡️ WHITE HAT / ETHICAL"
EOF

chmod +x "$PREFIX/bin/czh-update"

printf '\n\033[1;32m✅ CZH INSTALLATION COMPLETE\033[0m\n'
echo "⚡ CZH HACKERS"
echo "👑 AARHIV HACKERS"
echo "🔐 CIPHER ZERO HACKERS"
echo "🛡️ WHITE HAT / ETHICAL"
echo "🚀 Startup banner: ENABLED"
echo "🔄 Update command: czh-update"
echo
echo "🔐 Learn Legally • Stay Ethical • Grow Together"
